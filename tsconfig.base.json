{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    // `NodeNext`, not `Bundler`. These packages are run by Node directly (via
    // `npx`), not fed through a bundler, so module resolution has to match what
    // Node actually does — which includes requiring explicit `.js` extensions on
    // relative imports, even though the sources are `.ts`.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2023"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "skipLibCheck": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  }
}
